import java.util.concurrent.Semaphore;

public class Barriera {
    static int arrived = 0;
    static final int N = 5;
    static Semaphore mutex = new Semaphore(1);
    static Semaphore barrier = new Semaphore(0);

    public static void main(String[] args) {
        for (int i = 1; i <= N; i++) {
            final int id = i;
            new Thread(() -> {
                try {
                    System.out.println("Thread " + id + " arriva");
                    mutex.acquire();
                    arrived++;
                    if (arrived == N) {
                        barrier.release(N); // libera tutti
                    }
                    mutex.release();
                    barrier.acquire(); // aspetta che tutti arrivino
                    System.out.println("Thread " + id + " riparte");
                } catch (InterruptedException e) {}
            }).start();
        }
    }
}
